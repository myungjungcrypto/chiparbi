VITE_STANDIN_MODE=BTC
VITE_WS_PROXY_URL=
VITE_ACROSS_INTEGRATOR_ID=0xdead

# Optional: override the default public RPC used by the OFT Bridge Helper
# for peers() discovery and quoteSend() calls. Per-chain overrides use
# VITE_RPC_<UPPERCASED_CHAINKEY>. Chain keys are from LZ_CHAINS in src/lib/oft.ts
# (e.g. ETHEREUM, ARBITRUM, BASE, OPTIMISM, BSC, POLYGON, AVALANCHE,
# MANTLE, LINEA, SCROLL, BLAST).
# VITE_RPC_ETHEREUM=https://your-eth-rpc
# VITE_RPC_ARBITRUM=https://your-arb-rpc
# VITE_RPC_BASE=https://your-base-rpc
